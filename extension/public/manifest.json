{
  "manifest_version": 3,

  "name": "Druid",
  "version": "1.0",
  "description": "WIP.",

  "action": {
    "default_popup": "./popup.html",
    "default_title": "Druid"
  },

  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "scripting",
    "identity"
  ],

  "oauth2": {
    "client_id": "92990634906-2dmv78euomqlof6gci53sb1ica048l7g.apps.googleusercontent.com",
    "scopes": [
      "openid",
      "email",
      "profile"
    ]
  },

  "host_permissions": [
    "<all_urls>",
    "https://huggingface.co/*",
    "https://generativelanguage.googleapis.com/*",
    "https://accounts.google.com/*"
  ],

  "background": {
    "service_worker": "./background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["./content.js"],
      "run_at": "document_idle"
    }
  ],

  "icons": {
    "16": "./icons/icon16.png",
    "48": "./icons/icon48.png",
    "128": "./icons/icon128.png"
  },

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },

  "web_accessible_resources": [
    {
      "resources": ["index.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
